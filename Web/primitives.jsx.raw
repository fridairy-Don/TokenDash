// Shared chart/ring/bar primitives used across variants

function Sparkline({ data, width = 64, height = 18, stroke = TD.coral, fill, dots = false }) {
  const max = Math.max(...data), min = Math.min(...data);
  const range = max - min || 1;
  const step = width / (data.length - 1);
  const pts = data.map((v, i) => [i * step, height - ((v - min) / range) * (height - 2) - 1]);
  const d = pts.map((p, i) => (i === 0 ? 'M' : 'L') + p[0].toFixed(1) + ' ' + p[1].toFixed(1)).join(' ');
  const area = `${d} L ${width} ${height} L 0 ${height} Z`;
  return (
    <svg width={width} height={height} style={{ display: 'block', overflow: 'visible' }}>
      {fill && <path d={area} fill={fill} />}
      <path d={d} fill="none" stroke={stroke} strokeWidth="1.25" strokeLinecap="round" strokeLinejoin="round" />
      {dots && pts.map((p, i) => (
        <circle key={i} cx={p[0]} cy={p[1]} r={i === pts.length - 1 ? 1.8 : 0.8} fill={stroke} />
      ))}
    </svg>
  );
}

function SparkBars({ data, width = 160, height = 36, fill = TD.coral, muted = '#EDE7D8', gap = 3 }) {
  const max = Math.max(...data);
  const barW = (width - gap * (data.length - 1)) / data.length;
  return (
    <svg width={width} height={height} style={{ display: 'block' }}>
      {data.map((v, i) => {
        const h = (v / max) * height;
        const x = i * (barW + gap);
        const y = height - h;
        const isLast = i === data.length - 1;
        return <rect key={i} x={x} y={y} width={barW} height={h} rx="1" fill={isLast ? fill : muted} />;
      })}
    </svg>
  );
}

function QuotaBar({ pct, color = 'green', height = 6, warn = false, dark = false }) {
  const palette = dark ? {
    track: TD.dBorder,
    green: TD.dGreen, red: TD.dRed, coral: TD.dCoral,
  } : {
    track: '#EDE7D8',
    green: TD.green, red: TD.red, coral: TD.coral,
  };
  const bar = palette[color] || palette.green;
  return (
    <div style={{
      position: 'relative', width: '100%', height, borderRadius: height / 2,
      background: palette.track, overflow: 'hidden',
    }}>
      <div style={{
        position: 'absolute', top: 0, left: 0, bottom: 0,
        width: Math.min(100, pct) + '%',
        background: bar,
        borderRadius: height / 2,
        animation: warn ? 'td-pulse 2.2s ease-in-out infinite' : undefined,
      }} />
    </div>
  );
}

function Ring({ pct, size = 72, stroke = 6, color = TD.coral, track = '#EDE7D8', children }) {
  const r = (size - stroke) / 2;
  const c = 2 * Math.PI * r;
  const off = c * (1 - pct / 100);
  return (
    <div style={{ position: 'relative', width: size, height: size }}>
      <svg width={size} height={size} style={{ transform: 'rotate(-90deg)' }}>
        <circle cx={size/2} cy={size/2} r={r} fill="none" stroke={track} strokeWidth={stroke} />
        <circle cx={size/2} cy={size/2} r={r} fill="none" stroke={color} strokeWidth={stroke}
          strokeDasharray={c} strokeDashoffset={off} strokeLinecap="round" />
      </svg>
      <div style={{
        position: 'absolute', inset: 0, display: 'flex',
        alignItems: 'center', justifyContent: 'center',
      }}>{children}</div>
    </div>
  );
}

function ModelBar({ models, dark = false, height = 8 }) {
  const colors = dark
    ? ['#D98B6F', '#C48872', '#9E6E5C', '#5E544A']
    : [TD.coral, '#D89780', '#B8897C', '#A59684'];
  return (
    <div style={{
      display: 'flex', width: '100%', height, borderRadius: height/2, overflow: 'hidden',
      background: dark ? TD.dBorder : '#EDE7D8',
    }}>
      {models.map((m, i) => (
        <div key={i} style={{ width: m.pct + '%', background: colors[i] }} />
      ))}
    </div>
  );
}

// macOS menu bar chrome Ñ just the top strip above the popover
function MenuBarStrip({ dark = false }) {
  const bg = dark ? 'rgba(40,36,30,0.88)' : 'rgba(245,241,232,0.82)';
  const ink = dark ? TD.dInkMuted : TD.inkMuted;
  return (
    <div style={{
      position: 'absolute', top: -24, left: 0, right: 0, height: 24,
      background: bg,
      borderBottom: `1px solid ${dark ? TD.dBorder : TD.border}`,
      backdropFilter: 'blur(20px)',
      display: 'flex', alignItems: 'center', gap: 14,
      padding: '0 12px 0 14px',
      fontFamily: TD_FONTS.sans,
      fontSize: 12, color: ink, fontWeight: 500,
      borderTopLeftRadius: 0, borderTopRightRadius: 0,
    }}>
      {/* wifi */}
      <svg width="14" height="10" viewBox="0 0 14 10" fill="none"><path d="M7 9.5a1 1 0 100-2 1 1 0 000 2zM7 6a3.5 3.5 0 012.47 1.03l.71-.71a4.5 4.5 0 00-6.36 0l.71.71A3.5 3.5 0 017 6zm0-3a6.5 6.5 0 014.6 1.9l.71-.71a7.5 7.5 0 00-10.62 0l.71.71A6.5 6.5 0 017 3zm0-3a9.5 9.5 0 016.72 2.78l.71-.71a10.5 10.5 0 00-14.86 0l.71.71A9.5 9.5 0 017 0z" fill="currentColor"/></svg>
      {/* battery */}
      <div style={{ display: 'flex', alignItems: 'center', gap: 2 }}>
        <span style={{ fontSize: 11 }}>78%</span>
        <svg width="24" height="10" viewBox="0 0 24 10" fill="none">
          <rect x="0.5" y="0.5" width="21" height="9" rx="2" stroke="currentColor" opacity="0.6"/>
          <rect x="2" y="2" width="16" height="6" rx="1" fill="currentColor"/>
          <rect x="22" y="3" width="1.5" height="4" rx="0.5" fill="currentColor" opacity="0.6"/>
        </svg>
      </div>
      {/* search */}
      <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><circle cx="5" cy="5" r="3.5" stroke="currentColor" strokeWidth="1.2"/><path d="M7.5 7.5l3 3" stroke="currentColor" strokeWidth="1.2" strokeLinecap="round"/></svg>
      {/* Our app Ñ highlighted */}
      <div style={{
        display: 'flex', alignItems: 'center', gap: 5,
        color: dark ? TD.dInk : TD.ink, fontWeight: 600,
        background: dark ? 'rgba(217,139,111,0.15)' : 'rgba(204,120,92,0.12)',
        padding: '2px 6px', borderRadius: 4,
        fontFamily: TD_FONTS.serif, fontStyle: 'italic',
      }}>
        <span style={{
          width: 5, height: 5, borderRadius: 10,
          background: dark ? TD.dCoral : TD.coral,
        }} />
        TD
      </div>
      <div style={{ flex: 1 }} />
      <span style={{ fontVariantNumeric: 'tabular-nums' }}>Mon Apr 20  2:47 PM</span>
    </div>
  );
}

Object.assign(window, { Sparkline, SparkBars, QuotaBar, Ring, ModelBar, MenuBarStrip });
